# ============================================================================
# Linkfields – LOCAL template: copy to .env for your machine. Test and prod have their own templates:
# .env.test.example and .env.prod.example. Run: docker compose up -d (uses .env)  |  --env-file .env.test / .env.prod
# Never commit the filled-in copies (.gitignore excludes .env and .env.*). Secrets: openssl rand -base64 32
# ============================================================================

# ---- Stack ----
# Separate compose project = separate containers, database and media volumes.
COMPOSE_PROJECT_NAME=linkfields
WEB_PORT=3000
CMS_PORT=1337

# ---- Public URLs ----
# SITE_URL is baked into the website build: rebuild "web" after changing it.
SITE_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3000
# CMS_PUBLIC_URL is embedded in the admin bundle: rebuild "cms" after changing it.
CMS_PUBLIC_URL=http://localhost:1337
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
# true when the CMS runs behind an HTTPS reverse proxy / load balancer.
IS_PROXIED=false

# ---- Database ----
POSTGRES_DB=linkfields_cms
POSTGRES_USER=linkfields
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32

# ---- Strapi secrets ----
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-openssl-rand-base64-32
ADMIN_JWT_SECRET=replace-with-openssl-rand-base64-32
TRANSFER_TOKEN_SALT=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
JWT_SECRET=replace-with-openssl-rand-base64-32
# Shared by the CMS publish webhook and the website's /api/revalidate.
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32

# ---- Website ↔ CMS tokens ----
# Lead token: CMS › Settings › API Tokens › website-leads › Regenerate (one per environment/database).
STRAPI_LEAD_TOKEN=
STRAPI_READ_TOKEN=
MEDIA_HOSTS=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Enquiry emails: Microsoft 365 via Microsoft Graph (app "Linkfields_Website_New") ----
ENQUIRY_EMAILS_ENABLED=false
ENQUIRY_NOTIFY_TO=sales@linkfields.com
EMAIL_FROM="Linkfields Sales <sales@linkfields.com>"
EMAIL_REPLY_TO=sales@linkfields.com
EMAIL_PROVIDER=graph
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox the emails are sent from (empty = the address in EMAIL_FROM).
MS_GRAPH_SENDER=
