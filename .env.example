# Copy to .env for Docker Compose. Generate every secret with: openssl rand -base64 32
POSTGRES_DB=linkfields_cms
POSTGRES_USER=linkfields
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-openssl-rand-base64-32
ADMIN_JWT_SECRET=replace-with-openssl-rand-base64-32
TRANSFER_TOKEN_SALT=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
JWT_SECRET=replace-with-openssl-rand-base64-32
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32

# Optional integrations.
STRAPI_READ_TOKEN=
STRAPI_LEAD_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
MEDIA_HOSTS=
# Enquiry emails (optional) via Microsoft 365 / Microsoft Graph (Entra ID app with Mail.Send application
# permission, limited to the sending mailbox). Leave ENQUIRY_EMAILS_ENABLED=false until MS_GRAPH_* is filled in.
# Set-up steps: docs/CMS-BRANDING-AND-EMAIL.md
WEBSITE_URL=http://localhost:3000
ENQUIRY_EMAILS_ENABLED=false
ENQUIRY_NOTIFY_TO=sales@linkfields.com
EMAIL_PROVIDER=graph
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=sales@linkfields.com
MS_GRAPH_SAVE_TO_SENT_ITEMS=true
# SMTP is used only with EMAIL_PROVIDER=nodemailer (e.g. a local Mailpit test inbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Linkfields Sales <sales@linkfields.com>"
EMAIL_REPLY_TO=sales@linkfields.com
