flowchart LR
    V["Visitors<br/>www.linkfields.com"]:::user --> CF
    E["Editors<br/>cms.linkfields.com"]:::user --> CF
    subgraph CF["Cloudflare"]
      direction TB
      DNS["DNS + TLS<br/>apex → www redirect"]
      WAF["WAF, rate limit,<br/>Turnstile on forms"]
      CACHE["Edge cache<br/>pages and assets"]
    end
    CF --> ALB
    subgraph AWS["AWS (Terraform in infra/terraform)"]
      direction TB
      ALB["Application Load Balancer<br/>ACM certificates"]
      WEB["Website: Next.js<br/>ECS Fargate, 2 to 10 tasks"]
      CMS["CMS: Strapi 5<br/>ECS Fargate"]
      DB[("PostgreSQL<br/>RDS Multi-AZ")]
      S3[("Media<br/>S3 + CloudFront")]
      SEC["Secrets Manager"]
      MAIL["Email: SES or SMTP<br/>lead notifications"]
      ALB --> WEB
      ALB --> CMS
      WEB -->|content API| CMS
      CMS --> DB
      CMS --> S3
      CMS -.-> MAIL
      SEC -.-> WEB
      SEC -.-> CMS
    end
    M["media.linkfields.com"]:::user --> S3
    classDef user fill:#FF7800,stroke:#FF7800,color:#fff
    style CF fill:#FFF7ED,stroke:#F59E0B
    style AWS fill:#EFF6FF,stroke:#3B82F6
