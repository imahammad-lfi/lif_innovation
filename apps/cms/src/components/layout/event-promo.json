{
  "collectionName": "components_layout_event_promos",
  "info": {
    "displayName": "Event pop-up",
    "icon": "calendar",
    "description": "Site-wide pop-up and reminder for an Event. Empty dates, venue and stand fall back to the Event. Default window: from publishing until the end of the day after the event ends; on that last day the follow-up text is shown."
  },
  "options": {},
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "promoId": {
      "type": "string",
      "regex": "^[a-z0-9-]+$"
    },
    "showFrom": {
      "type": "datetime"
    },
    "hideAfter": {
      "type": "datetime"
    },
    "delaySeconds": {
      "type": "integer",
      "default": 4,
      "min": 0,
      "max": 60
    },
    "excludePaths": {
      "type": "text"
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": false
    },
    "titleHighlight": {
      "type": "string"
    },
    "body": {
      "type": "text"
    },
    "badgeLabel": {
      "type": "string"
    },
    "badgeImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "quote": {
      "type": "text"
    },
    "quoteAuthor": {
      "type": "string"
    },
    "quoteRole": {
      "type": "string"
    },
    "dateLabel": {
      "type": "string"
    },
    "venueLabel": {
      "type": "string"
    },
    "standLabel": {
      "type": "string"
    },
    "calendarTitle": {
      "type": "string"
    },
    "calendarStart": {
      "type": "date"
    },
    "calendarEnd": {
      "type": "date"
    },
    "calendarLocation": {
      "type": "string"
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link"
    },
    "secondaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link"
    },
    "pillLabel": {
      "type": "string"
    },
    "followUpEyebrow": {
      "type": "string"
    },
    "followUpTitle": {
      "type": "string"
    },
    "followUpBody": {
      "type": "text"
    },
    "followUpCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link"
    }
  }
}