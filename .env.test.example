# ============================================================================
# Linkfields – TEST environment template. Copy to .env.test on the test server and fill in the secrets.
# Run: docker compose --env-file .env.test up -d --build
# Never commit .env.test (git-ignored). Secrets: openssl rand -base64 32 (different from local and prod).
# ============================================================================

# ---- Stack ----
# Own compose project = own containers, database and media volumes (never shared with local or prod).
COMPOSE_PROJECT_NAME=linkfields-test
WEB_PORT=3010
CMS_PORT=1337

# ---- Public URLs (test server: website https://lfinew.lfidemo.com, CMS http://100.127.234.5:1337) ----
# These go into email links (WEBSITE_URL) and the "Open lead in CMS" button (CMS_PUBLIC_URL). Never localhost here.
# SITE_URL is baked into the website build and CMS_PUBLIC_URL into the admin bundle: rebuild after changing them.
SITE_URL=https://lfinew.lfidemo.com
WEBSITE_URL=https://lfinew.lfidemo.com
CMS_PUBLIC_URL=http://100.127.234.5:1337
CORS_ORIGINS=https://lfinew.lfidemo.com,http://100.127.234.5:1337
# true behind an HTTPS reverse proxy / load balancer (the test CMS is served directly over HTTP).
IS_PROXIED=false

# ---- Database ----
POSTGRES_DB=linkfields_cms
POSTGRES_USER=linkfields
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32

# ---- Strapi secrets ----
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-openssl-rand-base64-32
ADMIN_JWT_SECRET=replace-with-openssl-rand-base64-32
TRANSFER_TOKEN_SALT=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
JWT_SECRET=replace-with-openssl-rand-base64-32
# Shared by the CMS publish webhook and the website's /api/revalidate.
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32

# ---- Website ↔ CMS tokens ----
# Lead token: test CMS › Settings › API Tokens › website-leads › Regenerate (the test database has its own).
STRAPI_LEAD_TOKEN=
STRAPI_READ_TOKEN=
MEDIA_HOSTS=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Enquiry emails: Microsoft 365 via Microsoft Graph (app "Linkfields_Website_New") ----
# Test enquiries go to ENQUIRY_NOTIFY_TO: point it at a test inbox so the sales team is not alerted.
ENQUIRY_EMAILS_ENABLED=true
ENQUIRY_NOTIFY_TO=sales@linkfields.com
EMAIL_FROM="Linkfields Sales <sales@linkfields.com>"
EMAIL_REPLY_TO=sales@linkfields.com
EMAIL_PROVIDER=graph
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox the emails are sent from (empty = the address in EMAIL_FROM).
MS_GRAPH_SENDER=
