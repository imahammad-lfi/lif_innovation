{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead",
    "description": "Contact form submissions from the website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reference": {
      "type": "string",
      "unique": true,
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phoneCountry": {
      "type": "string",
      "maxLength": 2
    },
    "service": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "sourcePath": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    },
    "enquiryType": {
      "type": "string",
      "maxLength": 200
    },
    "emailStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "sent",
        "failed",
        "not-configured"
      ],
      "default": "pending"
    },
    "emailSentAt": {
      "type": "datetime"
    },
    "emailError": {
      "type": "text",
      "private": true
    }
  }
}
