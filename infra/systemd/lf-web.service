# Linkfields website – Next.js 16 production server reading content from Strapi.
# Build first in the run directory: `node node_modules/next/dist/bin/next build` (needs the CMS reachable).
[Unit]
Description=Linkfields website (Next.js 16, production)
After=network-online.target lf-cms.service
Wants=network-online.target lf-cms.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lf-run/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/opt/node26/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node26/bin/node node_modules/next/dist/bin/next start -p 3001 -H 0.0.0.0
Restart=always
RestartSec=3
StandardOutput=append:/var/log/linkfields/web.log
StandardError=append:/var/log/linkfields/web.log

[Install]
WantedBy=multi-user.target
