# Content source: strapi (default) or local. Local content is intended only for development.
CONTENT_SOURCE=strapi
# Internal CMS URL at runtime; pass a public CMS URL as a Docker build argument in CI when prerendering.
STRAPI_URL=http://localhost:1337
# Optional Strapi read token for private content.
STRAPI_READ_TOKEN=
# Strapi API token with only api::lead.lead.create for POST /api/contact.
STRAPI_LEAD_TOKEN=
# Shared secret accepted by POST /api/revalidate from the Strapi webhook.
REVALIDATE_SECRET=
# Optional Cloudflare Turnstile secret used server-side to validate contact submissions.
TURNSTILE_SECRET_KEY=
# Public Turnstile site key. This is a Docker build argument in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Canonical public site URL. This is a Docker build argument in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated host names allowed by next/image, for example media.linkfields.com.
MEDIA_HOSTS=
# Required only when CONTENT_SOURCE=local; absolute or app-relative directory containing local content.
LOCAL_CONTENT_DIR=
