# Server and reverse proxy
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false
PROXY_IP_HEADER=X-Forwarded-For
PROXY_MAX_IPS_COUNT=2

# Generate each with: openssl rand -base64 32
# APP_KEYS must be a comma-separated list of at least two independent values.
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-a-random-value
ADMIN_JWT_SECRET=replace-with-a-random-value
TRANSFER_TOKEN_SALT=replace-with-a-random-value
ENCRYPTION_KEY=replace-with-a-random-value
JWT_SECRET=replace-with-a-random-value

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=linkfields_cms
DATABASE_USERNAME=linkfields
DATABASE_PASSWORD=replace-with-a-password
# DATABASE_URL overrides the individual PostgreSQL connection values when set.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Upload storage: local for development/Compose, aws-s3 for ECS.
UPLOAD_PROVIDER=local
AWS_BUCKET=
AWS_REGION=eu-west-2
AWS_ACL=private
CDN_URL=
CDN_ROOT_PATH=
UPLOAD_SIZE_LIMIT=52428800
AWS_SIGNED_URL_EXPIRES=900

# Browser and Strapi webhook integration; comma-separated arrays are accepted by Strapi env.array.
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
CSP_MEDIA_HOSTS=
WEBSITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEBSITE_REVALIDATE_SECRET=

# Seed operation only: set SEED_LEAD_TOKEN=1 once to create and print the lead create-only API token.
SEED_DIR=
SEED_LEAD_TOKEN=

# Email — enquiry thank-you to the visitor + alert to sales (config/plugins.ts, src/utils/enquiry-email.ts)
# Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false SMTP_REQUIRE_TLS=true
# Brevo:         SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_REQUIRE_TLS=true
# Amazon SES:    SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587 SMTP_REQUIRE_TLS=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Linkfields Sales <sales@linkfields.com>"
EMAIL_REPLY_TO=sales@linkfields.com
EMAIL_TEST_ADDRESS=sales@linkfields.com
ENQUIRY_EMAILS_ENABLED=true
ENQUIRY_NOTIFY_TO=sales@linkfields.com
WEBSITE_URL=https://www.linkfields.com
