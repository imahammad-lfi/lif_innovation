# ============================================================================
# Linkfields – PRODUCTION environment template. Copy to .env.prod on the production server and fill in the secrets.
# Run: docker compose --env-file .env.prod up -d --build
# Never commit .env.prod (git-ignored). Secrets: openssl rand -base64 32 (different from local and test).
# ============================================================================

# ---- Stack ----
# Own compose project = own containers, database and media volumes (never shared with local or test).
COMPOSE_PROJECT_NAME=linkfields-prod
WEB_PORT=3000
CMS_PORT=1337

# ---- Public URLs (CHANGE ME if the CMS address differs) ----
# These go into email links (WEBSITE_URL) and the "Open lead in CMS" button (CMS_PUBLIC_URL). Never localhost here.
# SITE_URL is baked into the website build and CMS_PUBLIC_URL into the admin bundle: rebuild after changing them.
SITE_URL=https://www.linkfields.com
WEBSITE_URL=https://www.linkfields.com
CMS_PUBLIC_URL=https://cms.linkfields.com
CORS_ORIGINS=https://www.linkfields.com,https://linkfields.com,https://cms.linkfields.com
# true behind an HTTPS reverse proxy / load balancer.
IS_PROXIED=true

# ---- Database ----
POSTGRES_DB=linkfields_cms
POSTGRES_USER=linkfields
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32

# ---- Strapi secrets ----
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-openssl-rand-base64-32
ADMIN_JWT_SECRET=replace-with-openssl-rand-base64-32
TRANSFER_TOKEN_SALT=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
JWT_SECRET=replace-with-openssl-rand-base64-32
# Shared by the CMS publish webhook and the website's /api/revalidate.
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32

# ---- Website ↔ CMS tokens ----
# Lead token: prod CMS › Settings › API Tokens › website-leads › Regenerate (the prod database has its own).
STRAPI_LEAD_TOKEN=
STRAPI_READ_TOKEN=
MEDIA_HOSTS=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Enquiry emails: Microsoft 365 via Microsoft Graph (app "Linkfields_Website_New") ----
ENQUIRY_EMAILS_ENABLED=true
ENQUIRY_NOTIFY_TO=sales@linkfields.com
EMAIL_FROM="Linkfields Sales <sales@linkfields.com>"
EMAIL_REPLY_TO=sales@linkfields.com
EMAIL_PROVIDER=graph
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox the emails are sent from (empty = the address in EMAIL_FROM).
MS_GRAPH_SENDER=
