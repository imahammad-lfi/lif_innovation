{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Every website page. Sections are rendered top-to-bottom in the order shown here."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "path": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^/[A-Za-z0-9\\-_/&%.]*$"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.contact-form",
        "sections.events-list",
